WORK115_DATA_DIR=data
WORK115_ADAPTER=disabled
WORK115_SCHEDULER_ENABLED=true
WORK115_TICK_SECONDS=5
WORK115_STABLE_SECONDS=15
# 私密凭据请放在不提交的 .env 文件中。
WORK115_LOCAL_NO_AUTH=true
# 可选：将已挂载的本地/NAS 工作根目录放在这里，自动创建中文功能目录。
# WORK115_LOCAL_ROOT=/work
# WORK115_API_TOKEN=
# WORK115_COOKIE=
# WORK115_ALLOWED_SOURCE_ROOTS=["/mounts/nas"]
# WORK115_ALLOWED_OUTPUT_ROOTS=["/outputs"]
# WORK115_ALLOWED_WEBHOOK_HOSTS=["notify.example.com"]
# WORK115_ALLOWED_DOWNLOAD_HOSTS=[".115.com",".115cdn.com",".anxia.com"]
# 默认使用内置 xtractr，无需安装 7-Zip。
# WORK115_XTRACTR_PATH=bin/115work-extract.exe
# 可选的兼容解压引擎，需自行安装：
# WORK115_EXTRACT_ENGINE=7zip
# WORK115_EXTRACTOR_PATH=C:/Program Files/7-Zip/7z.exe
